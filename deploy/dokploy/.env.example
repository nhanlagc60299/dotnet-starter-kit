# ──────────────────────────────────────────────────────────────────────
# FullStackHero — Dokploy production environment.
# Paste into the compose app's Environment tab (Dokploy writes it to a .env
# next to the compose file). NEVER commit a filled-in copy.
# Compose refuses to start until every required (?-flagged) var is set.
# ──────────────────────────────────────────────────────────────────────

# ── Images ──────────────────────────────────────────────────────────
# GitHub owner of the GHCR images CI publishes (ghcr.io/<owner>/fsh-api,
# ghcr.io/<owner>/fsh-db-migrator). Lowercase.
GHCR_OWNER=nhanlagc60299
# dev-latest | latest | a release version. Pin a version for repeatable deploys.
# No v* tag exists yet and CI only pushes `dev-latest` until one does: keep dev-latest.
# Images are pulled on every deploy (pull_policy: always), so a moved mutable tag is picked up.
FSH_IMAGE_TAG=dev-latest

# ── Public URLs ─────────────────────────────────────────────────────
# What end users' browsers hit (the domains you attach in Dokploy). Baked into
# the frontends' /config.json and used for CORS and e-mail links.
FSH_API_URL=https://api.example.com
FSH_ADMIN_URL=https://admin.example.com
FSH_DASHBOARD_URL=https://app.example.com
FSH_DEFAULT_TENANT=root

# ── Modules (all off by default; the same value reaches migrator and API) ─
FSH_MODULE_BILLING=false
FSH_MODULE_CATALOG=false
FSH_MODULE_TICKETS=false
FSH_MODULE_CHAT=false

# ── Database roles ──────────────────────────────────────────────────
# The `db-roles` service creates app_migrate (DDL, migrator), app_runtime (DML, API) and
# app_readonly (SELECT) on every deploy and sets these passwords. Compose builds the
# connection strings from them. Use URL/connection-string-safe values (no `;` or spaces):
#   openssl rand -hex 24
APP_MIGRATE_PASSWORD=
APP_RUNTIME_PASSWORD=
APP_READONLY_PASSWORD=

# ── Secrets ─────────────────────────────────────────────────────────
# JWT signing key: 32+ chars, must NOT contain "replace-with".
# Generate with:    openssl rand -base64 48
JWT_SIGNING_KEY=
# Root admin password used by the seeder on first boot (admin@root.com). Rotate after login.
SEED_ADMIN_PASSWORD=
# Hangfire dashboard (<FSH_API_URL>/jobs). UserName min 3, Password min 12 chars.
HANGFIRE_USERNAME=
HANGFIRE_PASSWORD=
# Bootstrap superuser `fsh`; used by db-roles and for emergencies, never by the app.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Backup (mandatory) ──────────────────────────────────────────────
# The `backup` service dumps the database daily to this S3-compatible bucket (Cloudflare R2:
# endpoint https://<account-id>.r2.cloudflarestorage.com) and verifies a restore monthly.
# The deploy FAILS (by design) while any of the four is empty. The bucket must already exist;
# an object-scoped token (read + write) is enough. Retention = the bucket's lifecycle rule,
# the service never deletes anything (README, "Backup and restore").
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Optional. Key prefix inside the bucket; rclone provider (Cloudflare for R2, Other for any other
# S3-compatible store); schedules in UTC; Uptime Kuma push-monitor URLs, each pinged only after a
# successful backup / restore verification.
# BACKUP_S3_PREFIX=fsh
# BACKUP_S3_PROVIDER=Cloudflare
# BACKUP_CRON=0 2 * * *
# RESTORE_VERIFY_CRON=0 4 1 * *
# Restore verification FAILS when the newest backup is older than this many hours.
# RESTORE_VERIFY_MAX_AGE_HOURS=72
# BACKUP_PING_URL=
# RESTORE_VERIFY_PING_URL=

# ── Mail ────────────────────────────────────────────────────────────
# No catcher in production. StartTls for port 587, SslOnConnect for 465.
FSH_SMTP_HOST=
FSH_SMTP_PORT=587
FSH_SMTP_SECURITY=StartTls
FSH_SMTP_USERNAME=
FSH_SMTP_PASSWORD=
FSH_MAIL_FROM=

# ── Object storage (optional) ───────────────────────────────────────
# Default: local provider; files live in the `api_files` volume. NOT backed up off-site: the
# backup service covers the database only (README, "Lưu file off-site bằng R2").
#
# (a) Bundled RustFS (compose profile `storage`): uncomment the first three lines, fill BOTH keys,
#     add a Dokploy domain for service `rustfs` (port 9000) on FSH_S3_PUBLIC_URL. Also NOT off-site.
# (b) External S3 / Cloudflare R2, no profile: uncomment FSH_STORAGE_PROVIDER, set the SERVICE and
#     PUBLIC urls to the bucket endpoint (https://<account-id>.r2.cloudflarestorage.com), the bucket
#     name, the keys, and FSH_S3_PUBLIC_BASE_URL to the domain that serves public files.
# The deploy FAILS (by design) when provider=s3 and FSH_S3_PUBLIC_URL, FSH_S3_SERVICE_URL or a key
# is empty/invalid, or when the storage profile is on with a blank key (RustFS would otherwise
# start with its default credentials). RUSTFS_* are the S3 credentials for an external provider too.
# COMPOSE_PROFILES=storage
# FSH_STORAGE_PROVIDER=s3
# FSH_S3_PUBLIC_URL=https://s3.example.com
# FSH_S3_SERVICE_URL=http://rustfs:9000
# FSH_S3_BUCKET=fsh
# FSH_S3_PUBLIC_BASE_URL=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ── Observability (optional) ────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
